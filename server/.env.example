# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# MongoDB connection string (get one free at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/laras-crochet

# Long random string used to sign admin login tokens
# (generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-this-with-a-long-random-string

# Cloudinary — free tier, used for product photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — get from your Paystack dashboard (use TEST keys until launch)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# The URL your React frontend runs on, for CORS
CLIENT_URL=http://localhost:5173

PORT=5000
